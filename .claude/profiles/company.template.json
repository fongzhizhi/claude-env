{
  "model": "deepseek-v4-flash-0731",
  "env": {
    "ANTHROPIC_BASE_URL": "YOUR_COMPANY_BASE_URL_HERE",
    "ANTHROPIC_AUTH_TOKEN": "YOUR_COMPANY_API_KEY_HERE",
    "ANTHROPIC_MODEL": "deepseek-v4-flash-0731",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.2",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-v4-flash-0731",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-v4-flash-0731",
    "CLAUDE_CODE_SUBAGENT_MODEL": "glm-5.2",
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "DISABLE_INSTALLATION_CHECKS": "1",
    "MAX_THINKING_TOKENS": "32000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80"
  },
  "cleanupPeriodDays": 60,
  "language": "zh-CN",
  "autoUpdatesChannel": "stable",
  "theme": "dark-ansi",
  "showTurnDuration": true,
  "spinnerTipsEnabled": false,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Grep",
      "Find",
      "Glob",
      "LSP",
      "NotebookEdit",
      "Task",
      "TodoWrite",
      "ExitPlanMode",
      "WebFetch",
      "WebSearch",
      "mcp__cdp",
      "mcp__claude-vscode"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(dd *)",
      "Bash(mkfs.*)",
      "Bash(:(){ :|:& };:)",
      "Edit(**/*.secret.*)",
      "Write(**/*.secret.*)",
      "Write(**/.env)",
      "Write(**/id_rsa*)"
    ]
  }
}
